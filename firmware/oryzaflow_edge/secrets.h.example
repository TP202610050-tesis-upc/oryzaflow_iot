#pragma once
// ============================================================================
// PLANTILLA de credenciales. Copia este archivo como  secrets.h  y rellénalo.
//   secrets.h está en .gitignore (no se commitea: contiene clave WiFi, token de
//   ThingsBoard, claves LoRaWAN y la licencia Heltec del chip).
//
//   El transporte activo se elige en config.h (TRANSPORT_MODE). Cada módulo de red
//   incluye secrets.h solo dentro de su guarda:
//     TRANSPORT_WIFI    -> net_thingsboard.cpp usa WIFI_* y TB_*
//     TRANSPORT_LORAWAN -> net_lorawan.cpp usa LORAWAN_* y HELTEC_LICENSE
//   Conviene dejar los dos bloques rellenos para alternar sin editar este archivo.
//   Guía de entorno y placa: docs/LORAWAN.md §2.1.
// ============================================================================

// --- WiFi (2.4 GHz) — TRANSPORT_WIFI ---
#define WIFI_SSID  "TU_SSID_2.4GHZ"
#define WIFI_PASS  "TU_CLAVE_WIFI"

// --- ThingsBoard (cuenta en thingsboard.cloud) — TRANSPORT_WIFI ---
#define TB_HOST    "mqtt.thingsboard.cloud"
#define TB_PORT    1883                         // 1883 = sin TLS. 8883 = TLS.
#define TB_TOKEN   "ACCESS_TOKEN_DEL_DEVICE"    // Devices > tu device > Manage credentials

// --- LoRaWAN OTAA (The Things Stack) — TRANSPORT_LORAWAN ---
// Consola TTS > Applications > oryzaflow > End devices > oryzaflow-edge-01 (docs/LORAWAN.md §1).
// Bytes en orden MSB, tal como los muestra la consola con el formato "msb" / C-style.
// La región (AU915 FSB2) NO va aquí: se elige en el menú de placa LoRaWan Region = REGION_AU915
// (arduino-cli: sufijo :LORAWAN_REGION=4 del FQBN).
#define LORAWAN_DEV_EUI  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }   // DevEUI (8 B)
#define LORAWAN_APP_EUI  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }   // JoinEUI / AppEUI (8 B)
#define LORAWAN_APP_KEY  { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,                            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }   // AppKey (16 B)

// --- Licencia Heltec de la pila LoRaWAN precompilada — TRANSPORT_LORAWAN ---
// Va ligada al ChipID de CADA placa (Mcu.begin() lo imprime por serial y se bloquea
// pidiendo la licencia si falta). Se obtiene gratis en https://resource.heltec.cn/search
// introduciendo el ChipID. La misma placa sirve en cualquier PC; otra placa = otra licencia.
#define HELTEC_LICENSE   { 0x00000000, 0x00000000, 0x00000000, 0x00000000 }   // 4 x uint32_t
